# Supply-chain rules. Don't remove one without the owner's written decision. scripts/check-repo.mjs checks them.
# Dependency install scripts never run. `npm run <script>` still works, but pre*/post* hooks don't.
ignore-scripts=true
# Exact versions only, no ^ or ~ ranges.
save-exact=true
# Never resolve a version published less than 7 days ago (npm >= 11.10).
min-release-age=7
engine-strict=true
fund=false
